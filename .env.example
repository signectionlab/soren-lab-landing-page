# 로컬 개발 / Vercel 배포용 환경변수
# 이 파일을 복사해 .env 를 만들고 실제 값을 입력하세요.

# (이관 완료 후 제거 가능) Google Apps Script Web App URL
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOY_ID/exec

# Supabase (프론트 + build-env.js)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Supabase service role — 로컬 이관 스크립트 1회용, Vercel/Git에 넣지 마세요
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# (선택) SQL 자동 적용용 — Supabase Dashboard → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=your_personal_access_token

# setup-admin-users.js 1회 실행용 — Git/Vercel에 넣지 마세요
ADMIN1_PASSWORD=your_admin1_password
ADMIN2_PASSWORD=your_admin2_password
ADMIN3_PASSWORD=your_admin3_password
